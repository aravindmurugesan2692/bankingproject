# Copy to backend/.env (and optionally frontend/.env) — never commit secrets.

# --- Core ---
MOCK_MODE=true
DATABASE_URL=sqlite:///./occ_ai_assistant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=/api
APP_NAME=OCC AI Assistant

# Frontend (Vite) — leave empty to use same-origin /api via Vite proxy
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Phase 2 LLM (optional) ---
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# --- Phase 3 ServiceNow ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TIMEOUT_SECONDS=30
SERVICENOW_MAX_RETRIES=2

# --- Phase 4 PagerDuty ---
# Live paging only when MOCK_MODE=false AND key is set.
# Teams are never paged without explicit OCC approval.
PAGERDUTY_API_KEY=
PAGERDUTY_API_URL=https://api.pagerduty.com
# Optional legacy alias:
# PAGERDUTY_API_TOKEN=

# --- Later phases ---
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
