# Copy to .env (backend) and optionally frontend/.env — never commit secrets.

# --- Core ---
MOCK_MODE=true
DATABASE_URL=sqlite:///./occ_ai_assistant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=/api
APP_NAME=OCC AI Assistant

# Frontend (Vite) — leave empty to use same-origin /api via Vite proxy
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Later phases (placeholders only; unused in Phase 1) ---
OPENAI_API_KEY=
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
PAGERDUTY_API_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
