# Copy to backend/.env (and optionally frontend/.env) — never commit secrets.

# --- Core ---
MOCK_MODE=true
DATABASE_URL=sqlite:///./occ_ai_assistant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_PREFIX=/api
APP_NAME=OCC AI Assistant

# Frontend (Vite) — leave empty to use same-origin /api via Vite proxy
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Phase 2 LLM (optional) ---
# When MOCK_MODE=true OR OPENAI_API_KEY is empty → heuristic MOCK analysis is used.
# For live LLM: set MOCK_MODE=false and provide a key.
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# --- Later phases (placeholders) ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
PAGERDUTY_API_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
