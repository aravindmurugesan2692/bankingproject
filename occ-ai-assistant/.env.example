# Copy to occ-ai-assistant/.env (and optionally backend/.env).
# NEVER commit real secrets. Frontend must not embed API keys.

# --- Core ---
MOCK_MODE=true
DATABASE_URL=sqlite:///./occ_ai_assistant.db
# Docker compose default volume path:
# DATABASE_URL=sqlite:////data/occ_ai_assistant.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
API_PREFIX=/api
APP_NAME=OCC AI Assistant
EXPOSE_ERROR_DETAILS=false

# Frontend (Vite local only) — leave empty to use same-origin /api via Vite proxy
# VITE_API_BASE_URL=

# --- Phase 9 auth-ready demo ---
# demo = accept X-OCC-User / X-OCC-Role headers (default)
# disabled = fixed default identity
# oidc = stub returns 501 until a real IdP is wired (do not invent tokens)
AUTH_MODE=demo
AUTH_DEMO_ENABLED=true
AUTH_DEFAULT_USER=OCC Engineer · Demo User
AUTH_DEFAULT_ROLE=occ_engineer

# --- Phase 2 LLM (optional) ---
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45

# --- Phase 3 ServiceNow ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_TIMEOUT_SECONDS=30
SERVICENOW_MAX_RETRIES=2

# --- Phase 4 PagerDuty ---
# Live paging only when MOCK_MODE=false AND key is set.
# Teams are never paged without explicit OCC approval.
PAGERDUTY_API_KEY=
PAGERDUTY_API_URL=https://api.pagerduty.com
# Optional legacy alias:
# PAGERDUTY_API_TOKEN=
PAGERDUTY_TIMEOUT_SECONDS=30

# --- Phase 5 Microsoft Teams / Graph ---
# Live meetings only when MOCK_MODE=false AND all three are set.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MICROSOFT_GRAPH_TIMEOUT_SECONDS=30
